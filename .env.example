# 通义千问 API 配置（阿里云 DashScope，OpenAI 兼容端点）
# 复制本文件为 .env 并填入真实 Key：
#   QWEN_API_KEY=***

QWEN_API_KEY=your_api_key_here
QWEN_MODEL=qwen-plus
# 可选：情境分析用的快模型（结构化 JSON 任务，比主模型快 1~2 秒）
QWEN_ANALYSIS_MODEL=qwen-turbo
# 可选：embedding 模型（长期记忆语义检索用）
QWEN_EMBEDDING_MODEL=text-embedding-v3
# 可选：Qwen/DashScope 或其他 OpenAI 兼容服务
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 可选：单次请求超时（秒）
QWEN_TIMEOUT=60

# 数据库（开发用 SQLite，生产用 PostgreSQL）
DATABASE_URL=sqlite+aiosqlite:///./storage/companion.db
# 生产示例：DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/companion

# JWT
JWT_SECRET_KEY=dev-secret-change-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# 邮箱验证码登录（本地开发不填 SMTP 时，接口会返回 debug_code 便于测试）
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_CODE_EXPIRE_MINUTES=10
EMAIL_CODE_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5

# 应用
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ---------- 机器狗 / 小智服务（合并自 xiaozhi-esp32-server） ----------
# 小智视觉服务（xiaozhi-server 的 MCP Vision 接口，老人端拍照 → 图像理解）
# 本机直接跑 xiaozhi-server/app.py 时用 127.0.0.1:8003；Docker 部署时容器网络内用 http://xiaozhi:8003
XIAOZHI_VISION_URL=http://127.0.0.1:8003/mcp/vision/explain
XIAOZHI_DEVICE_ID=elderly_companion_web
# 可选：智控台绑定设备后的设备 token（默认走 web_test_client 测试通道，无需 token）
XIAOZHI_AUTH_TOKEN=
VISION_TIMEOUT=60

# 机器狗固件地址（ESP-Hi 的 HTTP /control 接口，局域网 IP）
DOG_BASE_URL=http://10.1.56.231
DOG_TIMEOUT=5

# ---------- 每日陪伴日报推送（家属端） ----------
# 每天定时把老人与陪伴助手的聊天汇总（统计 + AI 摘要）推进家属看板
DIGEST_ENABLED=true
DIGEST_HOUR=20          # 推送时刻（24 小时制，Asia/Shanghai）
DIGEST_MINUTE=30
# 调度器总开关：生产环境（ENVIRONMENT=production）默认开启；
# 开发环境默认关闭，本地想验证定时任务时设为 true
SCHEDULER_ENABLED=false

# ---------- 回忆录（生平故事 / 时代轴 / 故事板 / 照片） ----------
# 暗发布开关：关闭时 /chat 行为与既有功能完全不受影响。
# 待 M0 提取精度（precision ≥ 0.80）达标后再置 true 打开。
MEMOIR_ENABLED=false
# 单次会话最多追问几个缺口（契约3 硬上限，默认 1）
# 取值依据（真语料 60 轮回放，见 scripts/elicitation_probe.py）：
#   1 问 → 开口 5 次（8.3%）｜2 问 → 10 次（16.7%）｜3 问 → 11 次（18.3%）
# 1→2 让追问频率直接翻倍，而 2→3 只多一次——收益最差的一档。
# 契约3 是「主动追问但克制」，所以取 1。
MEMOIR_MAX_ASKS_PER_SESSION=1
# 同一缺口追问后的冷却天数（避免唠叨）
# 取值依据（同上回放）：1 天会多放行 1 次，3 天与 7/14 天结果**完全一致**。
# 说明 3 天已足够挡住重复追问，再拉长只会让缺口永远问不到，取 3。
MEMOIR_GAP_COOLDOWN_DAYS=3
# 夜间缺口扫描时刻（Asia/Shanghai，默认 01:30，早于 02:00 的记忆整合）
MEMOIR_GAP_SCAN_HOUR=1
MEMOIR_GAP_SCAN_MINUTE=30
# 故事板目标总时长（秒）；实际时长受每段 4~25 秒的限制，可能短于此值
MEMOIR_STORYBOARD_SECONDS=60
# 回忆照片落盘目录（相对 backend/）。
# 刻意不挂 StaticFiles：照片走鉴权接口读，否则创伤故事的 private 照片
# 就等于「知道 URL 就能看」（契约2）。库里只存相对路径。
MEMOIR_MEDIA_DIR=storage/memoir_media
# 单张照片大小上限（MB），与 vision 的 5MB 对齐
MEMOIR_MEDIA_MAX_MB=5
