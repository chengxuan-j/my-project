.env
__pycache__/
*.pyc
.venv/
venv/
backend/storage/*.db
backend/storage/*.db-wal
backend/storage/*.db-shm
# 回忆照片落盘目录：库里只存相对路径，照片本身是**用户私人内容**，绝不入库。
# 注意上面的 backend/storage/*.db 只匹配文件，匹配不到这个子目录，必须单独写。
backend/storage/memoir_media/
.pytest_cache/

# 运行日志与产物
*.log
*.err
tests_out.txt
# 编辑器/手工备份（如 start.bat.bak）——备份不该进版本库，历史里有就够
*.bak
# 回忆录 M0 提取质量报告（每次跑脚本重生成，不入库）
backend/data/story_probe_report.json

# 前端
node_modules/
.next/
# Next 的历史构建备份目录（.next.old_<ts> / .next.old2_<ts>），上面的 .next/ 规则匹配不到
.next.old*/

# 代码索引工具生成物
.codegraph/

# 机器狗 / 小智服务（合并自 xiaozhi-esp32-server）
# 注意：.gitignore 不支持行尾注释，注释必须单独成行。
# 否则整行（含 "# 注释"）会被当成一个模式，忽略规则静默失效——
# 这正是 robot/xiaozhi-server/data/.config.yaml（含 API Key）曾被盗提交的原因。
robot/xiaozhi-server/data/
robot/xiaozhi-server/tmp/
robot/xiaozhi-server/models/

# DeepFace 库源码（pip install -e ./deepface 装的，属于依赖不属于本项目代码）
/deepface/
